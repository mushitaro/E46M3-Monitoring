# dependencies
node_modules/
.pnp
.pnp.*

# next.js — `/out/` is anchored to the repo root. It used to be anchored for the
# OPPOSITE reason: an unanchored `out/` would also have matched
# tools/SgbdDump/out/, and those dumps were committed on purpose. That reasoning
# is now inverted — this repository is public and the dumps are BMW-derived — so
# the dumps live outside the tree entirely (see tools/paths.py). The anchor
# stays, but it is now only about the Next.js export.
/.next/
/out/
/build/
next-env.d.ts
*.tsbuildinfo

# .NET build-time tooling. tools/SgbdDump links EdiabasLib, which is GPLv3.
# Building it produces a combined work: the source here is MIT but the BINARY is
# not redistributable. Keeping bin/obj out of the repo is what makes that
# distinction hold in practice — see THIRD-PARTY-NOTICES.md §2.
[Bb]in/
[Oo]bj/

# python
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
#  Not ours to publish. This repository is PUBLIC and carries CODE ONLY.
#  Three different grounds, kept apart on purpose — see docs/PRESERVED.md.
# ---------------------------------------------------------------------------

# (1) BMW SGBD derivative — THIRD-PARTY-NOTICES.md §3.1. Generated from
#     C:\EDIABAS\ECU\*.prg, which is not ours to relicense. tools/terms/ is here
#     too: its dictionary KEYS are verbatim German SGBD strings.
#     Regenerate locally: tools/dump_modules.py, then tools/gen_ecu_data.py.
public/ecu-data/
tools/terms/

# Belt and braces. The dumps now live in $SGBD_DUMP_DIR outside the tree, but a
# stray copy here must never be committed. The manifest is hashes and counts
# only — no SGBD strings — so it IS published, and it is what makes the absent
# data reviewable.
tools/SgbdDump/out/
!tools/SgbdDump/out.manifest.json

# (2) Privacy, not licensing. These carry the vehicle's own identifiers and its
#     real fault history from a 2026-07-18 session. The identifiers are not
#     repeated here: a comment explaining why something is private is a poor
#     place to publish the thing it protects.
recordings/
!host/recordings/test-mss54.json

# EDIABAS interface traces. Same reason, and they are large (696 KB).
*.trc
trace/

# local env
.env*
!.env.example

# editors / os
.DS_Store
*.swp
.vscode/
.idea/

# 一時的な調査の書き出し。SGBD ダンプの断片や測定結果を UTF-8 で吐くのに使う。
# Windows の cp932 な stdout に非 ASCII を直接出すと落ちるので、ファイル経由で
# 読むことになる——そのファイルがコミットに紛れ込んだことが実際にあった。
/scratch*.txt
/scratch*.json
