{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "e46.intake-check.v1"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "producer": {
      "type": "object",
      "properties": {
        "app": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sgbdSet": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "required": [
        "app",
        "build",
        "sgbdSet"
      ],
      "additionalProperties": false
    },
    "practice": {
      "type": "boolean"
    },
    "profile": {
      "type": "object",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ]
        },
        "gearbox": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 20
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "engine",
        "gearbox"
      ],
      "additionalProperties": false
    },
    "measuredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "clock": {
      "type": "string",
      "enum": [
        "server",
        "device"
      ]
    },
    "scan": {
      "type": "object",
      "properties": {
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "end": {
          "type": "string",
          "enum": [
            "done",
            "not-parked",
            "stopped",
            "link-lost"
          ]
        }
      },
      "required": [
        "startedAt",
        "end"
      ],
      "additionalProperties": false
    },
    "odometerKm": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "vin": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-HJ-NPR-Z0-9]{17}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "vinShort": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-HJ-NPR-Z]{2}[0-9]{5}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "modules": {
      "maxItems": 80,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^0x[0-9A-F]{2}$"
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "sgbd": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "variant": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              {
                "type": "null"
              }
            ]
          },
          "basis": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "identified",
                  "m3-fitment"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "outcome": {
            "type": "string",
            "enum": [
              "answered",
              "identified",
              "silent",
              "rejected",
              "refused",
              "skipped"
            ]
          },
          "ident": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "partNo": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "hw": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sw": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 40
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "codingIndex": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 20
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "diagIndex": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 20
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "layout": {
                    "anyOf": [
                      {
                        "type": "string",
                        "enum": [
                          "ds2-common"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "raw": {
                    "type": "string",
                    "maxLength": 512,
                    "pattern": "^(?:[0-9a-f]{2})*$"
                  }
                },
                "required": [
                  "partNo",
                  "hw",
                  "sw",
                  "codingIndex",
                  "diagIndex",
                  "layout",
                  "raw"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "faultRaw": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 4096,
              "pattern": "^(?:[0-9a-f]{2})*$"
            }
          },
          "reason": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "address",
          "name",
          "sgbd",
          "variant",
          "basis",
          "outcome",
          "ident",
          "faultRaw",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "address": {
            "type": "string",
            "pattern": "^0x[0-9A-F]{2}$"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "text": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "present",
              "stored",
              "unknown"
            ]
          },
          "count": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "unverified": {
            "type": "boolean"
          },
          "raw": {
            "type": "string",
            "maxLength": 4096,
            "pattern": "^(?:[0-9a-f]{2})*$"
          }
        },
        "required": [
          "id",
          "address",
          "code",
          "text",
          "state",
          "count",
          "unverified",
          "raw"
        ],
        "additionalProperties": false
      }
    },
    "readings": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 80
              }
            ]
          },
          "unit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "name",
          "value",
          "unit"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "id",
    "producer",
    "practice",
    "profile",
    "measuredAt",
    "clock",
    "scan",
    "odometerKm",
    "vin",
    "vinShort",
    "modules",
    "findings",
    "readings"
  ],
  "additionalProperties": false
}
