<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OldBmwDiagHost</AssemblyName>
    <RootNamespace>OldBmwDiagHost</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- ==========================================================================
       既定 = mock（net9.0, ハード/EdiabasLib不要）。
       実機 = EdiabasLib 結線:  dotnet build -p:UseEdiabas=true
         → net8.0-windows で EdiabasLib を参照し EDIABASLIB を定義（検証済み: 0エラー）。
       前提:
         1) git clone https://github.com/uholeschak/ediabaslib  (→ C:\EC-APPS\ediabaslib)
         2) EdiabasLib は最新で net10 も対象 → .NET 10 SDK を入れるか、
            EdiabasLib.csproj の <TargetFrameworks> を net8.0-windows10.0.26100.0 のみに絞る。
  =========================================================================== -->
  <PropertyGroup Condition="'$(UseEdiabas)' != 'true'">
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(UseEdiabas)' == 'true'">
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <DefineConstants>$(DefineConstants);EDIABASLIB</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseEdiabas)' == 'true'">
    <ProjectReference Include="..\..\ediabaslib\EdiabasLib\EdiabasLib\EdiabasLib.csproj"
                      SetTargetFramework="TargetFramework=net8.0-windows10.0.26100.0" />
    <!-- EdiabasLib は Windows-1252 を使う → CodePagesEncodingProvider が必要 -->
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

</Project>
