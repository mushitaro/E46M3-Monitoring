{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The desk's door into what owners handed over (src/index.ts says what it serves and to whom).
  // A Worker of its own, not a route of the Pages project: the Pages project is behind the owner
  // gate, which this is not, and this answers only a desk token, which the Pages project never does.
  "name": "monitoring-desk",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": true,

  // The WORKS build's own database. Its schema is migrations/ at the repository root, applied
  // from the root wrangler.jsonc; this Worker applies none.
  "d1_databases": [
    {
      "binding": "RUNS_DB",
      "database_name": "tsunagi-m-preview-runs",
      "database_id": "caef60dd-7936-44be-9184-b4168791ee4f"
    }
  ]
}
