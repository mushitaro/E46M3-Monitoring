{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The desk's door into what owners handed over (src/index.ts says what it serves and to whom).
  //
  // A Pages project of its own, `monitoring-desk` → monitoring-desk.pages.dev, whose only content is
  // pages/_worker.js. Not a Worker: a Worker's own address is on the account's workers.dev name,
  // which is a person's, and a public URL does not carry one; and not a route of the WORKS Pages
  // project either, which is behind the owner gate, where this answers only a desk token.
  // tsunagi.app's DNS is not a Cloudflare zone, so a name under it would be a CNAME added there.
  //
  // It also holds the desk's INBOX for the Mainstays' engine reports (src/inbox.ts): M's platform
  // (the engine door, tsunagi-m-platform services/engine) posts each report to
  // /inbox/engine-report with its own ticket. That route's URL is the door's DESK_URL.
  //
  // Secrets (names only, `wrangler pages secret put <NAME> --project-name monitoring-desk`):
  //   DESK_DELIVER_KEY   the key shared with the platform's engine door (there: M_DESK_KEY, the
  //                      same value). Until it is set the inbox answers 503 and the door keeps
  //                      its reports and tries again.
  //   LOOP_FIRE_TOKEN    the autonomous loop's API-trigger token (the WORKS build's own, the same
  //                      value): a new engine report wakes the desk at once. Without it the
  //                      report waits for the loop's scheduled turn.
  //
  // Deploy:  npm run desk:deploy   (from the repository root; it runs wrangler in this folder)
  "name": "monitoring-desk",
  "pages_build_output_dir": "pages",
  "compatibility_date": "2026-07-31",

  // The WORKS build's own database. Its schema is migrations/ at the repository root, applied
  // from the root wrangler.jsonc; this project applies none.
  "d1_databases": [
    {
      "binding": "RUNS_DB",
      "database_name": "tsunagi-m-preview-runs",
      "database_id": "caef60dd-7936-44be-9184-b4168791ee4f"
    }
  ],
  "vars": {
    // The autonomous loop's scheduled task, woken when a store's error becomes a desk question
    // (functions/_lib/wake.ts). The same id as the WORKS build's.
    "LOOP_TRIGGER_ID": "trig_01TrL8w14QvVQNPv64HA4TYW"
  }
}
