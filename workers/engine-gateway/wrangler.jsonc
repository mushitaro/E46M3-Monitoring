{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // M's engine door for Mainstays (src/index.ts): the engine reports they send to the desk, and the
  // engine's private data they read. Apart from the WORKS build (operator, 2026-11-12): a Mainstay's
  // flow never depends on MESH's app or its releases.
  //
  // A Pages project of its own, `tsunagi-engine-gateway` → tsunagi-engine-gateway.pages.dev, whose
  // only code is pages/_worker.js (advanced mode: every request reaches the Worker first; the data is
  // read through ASSETS only after a ticket holds). A custom domain is the operator's to choose later.
  //
  // NOT CREATED YET. Deploy: npm run gateway:deploy (from the repository root). It copies
  // public/ecu-data (the private data, never committed) into pages/ecu-data and deploys pages/.
  //
  // Secrets (names only, `wrangler pages secret put <NAME> --project-name tsunagi-engine-gateway`):
  //   ENGINE_REPORT_SECRET_<SLUG>  one per Mainstay on the roster (gren-blue-auto →
  //                                ENGINE_REPORT_SECRET_GREN_BLUE_AUTO; suite-demo →
  //                                ENGINE_REPORT_SECRET_SUITE_DEMO). Until one is set, that store is refused.
  //   LOOP_FIRE_TOKEN              the autonomous loop's API-trigger token (the WORKS build's own, the
  //                                same value): a new engine report wakes the desk at once.
  "name": "tsunagi-engine-gateway",
  "pages_build_output_dir": "pages",
  "compatibility_date": "2026-07-31",

  // The WORKS build's own database: the desk's records live there. Its schema is migrations/ at the
  // repository root (0005 adds the gateway's tables), applied from the root wrangler.jsonc.
  "d1_databases": [
    {
      "binding": "RUNS_DB",
      "database_name": "tsunagi-m-preview-runs",
      "database_id": "caef60dd-7936-44be-9184-b4168791ee4f"
    }
  ],
  "vars": {
    // The Mainstays allowed in. Each also needs its own key (above).
    "ENGINE_REPORT_MAINSTAYS": "gren-blue-auto,suite-demo",
    // The autonomous loop's scheduled task, woken when a store's error becomes a desk question.
    "LOOP_TRIGGER_ID": "trig_01TrL8w14QvVQNPv64HA4TYW"
  }
}
